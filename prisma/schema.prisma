generator client {
  provider = "prisma-client-js"
}

// SQLite is used for local development. Prisma does not support an env-driven
// provider, so switch this one value to "postgresql" for production and run
// the PostgreSQL migration workflow documented in DEPLOYMENT.md.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String       @id @default(uuid())
  username        String       @unique
  email           String       @unique
  passwordHash    String
  role            String       @default("USER")
  country         String       @default("FI")
  faceitLevel     Int?
  faceitUsername  String?
  faceitId        String?
  faceitAvatar    String?
  faceitElo       Int?
  faceitVerifiedAt DateTime?
  inGameRole      String?
  
  teamsCaptained  Team[]       @relation("TeamCaptain")
  teamMemberships TeamMember[]
  joinRequests    JoinRequest[]
  lobbiesCaptained Lobby[]     @relation("LobbyCaptain")
  lobbySlots      LobbySlot[]
  lobbyRequests   LobbyRequest[]
  lobbyMessages   LobbyChatMessage[]
  notifications   Notification[]
  lobbyMembers    LobbyMember[]
  faceitProfile   FaceitProfile?
  
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model Team {
  id            String       @id @default(uuid())
  name          String       @unique
  logo          String?
  captainId     String
  rankingPoints Int          @default(1000)
  
  captain       User         @relation("TeamCaptain", fields: [captainId], references: [id])
  members       TeamMember[]
  joinRequests  JoinRequest[]
  
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model TeamMember {
  teamId          String
  userId          String
  faceitProfileId String
  slotNumber      Int
  role            String   @default("MEMBER")
  status          String   @default("ACTIVE")

  team          Team          @relation(fields: [teamId], references: [id])
  user          User          @relation(fields: [userId], references: [id])
  faceitProfile FaceitProfile @relation(fields: [faceitProfileId], references: [id])
  
  @@id([teamId, userId])
  @@unique([teamId, slotNumber])
}

model JoinRequest {
  id        String   @id @default(uuid())
  teamId    String
  userId    String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())

  team      Team     @relation(fields: [teamId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([teamId, userId, status])
}

model Tournament {
  id            String    @id @default(uuid())
  name          String
  status        String    @default("upcoming")
  date          DateTime?
  prizePool     Int       @default(0)
  teamCapacity  Int       @default(64)
  entryFee      Int       @default(0)
  format        String    @default("Single Elimination")
  registrationDeadline DateTime?
  faceitId      String?
  isActive      Boolean   @default(false)
  bracketData   Json?
  
  lobbies       Lobby[]
  matches       Match[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Lobby {
  id            String      @id @default(uuid())
  tournamentId  String
  name          String
  captainId     String
  status        String      @default("forming")
  description   String?
  
  tournament    Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  captain       User        @relation("LobbyCaptain", fields: [captainId], references: [id])
  slots         LobbySlot[]
  requests      LobbyRequest[]
  chatMessages  LobbyChatMessage[]
  members       LobbyMember[]
  
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model LobbySlot {
  id            String  @id @default(uuid())
  lobbyId       String
  userId        String?
  status        String  @default("empty") // empty, occupied
  requestedRole String?
  minFaceitLevel Int?
  slotIndex     Int
  
  lobby         Lobby   @relation(fields: [lobbyId], references: [id], onDelete: Cascade)
  user          User?   @relation(fields: [userId], references: [id])
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model LobbyMember {
  id              String        @id @default(uuid())
  lobbyId         String
  userId          String
  faceitProfileId String?
  slotIndex       Int
  role            String?       // CAPTAIN, MEMBER
  status          String        @default("active")
  joinedAt        DateTime      @default(now())

  lobby           Lobby         @relation(fields: [lobbyId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id])
  faceitProfile   FaceitProfile? @relation(fields: [faceitProfileId], references: [id])

  @@unique([lobbyId, slotIndex])
}

model LobbyRequest {
  id         String   @id @default(uuid())
  lobbyId    String
  userId     String
  slotId     String?
  status     String   @default("pending") // pending, accepted, rejected
  message    String?

  lobby      Lobby    @relation(fields: [lobbyId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id])

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model LobbyChatMessage {
  id        String   @id @default(uuid())
  lobbyId   String
  userId    String
  content   String

  lobby     Lobby    @relation(fields: [lobbyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

model Notification {
  id             String   @id @default(uuid())
  recipientId    String
  type           String
  title          String
  message        String
  lobbyId        String?
  joinRequestId  String?
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  recipient      User     @relation(fields: [recipientId], references: [id])
}

model FaceitProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  playerId      String
  username      String
  avatar        String?
  elo           Int?
  level         Int?
  profileUrl    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id])
  teamMembers   TeamMember[]
  lobbyMembers  LobbyMember[]
}

model Match {
  id            String    @id @default(uuid())
  tournamentId  String
  team1Id       String?
  team2Id       String?
  team1Score    Int       @default(0)
  team2Score    Int       @default(0)
  round         Int?
  status        String    @default("upcoming")
  faceitId      String?   @unique
  scheduledTime DateTime?
  
  tournament    Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}
